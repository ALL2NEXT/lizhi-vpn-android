{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["./.wrangler/worker-configuration.d.ts", "node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/admin-ui/scripts"]
}
