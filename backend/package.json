{
  "devDependencies": {
    "@types/node": "^24.19.1",
    "miniflare": "5.20260811.1-alpha",
    "typescript": "^5.9.3",
    "wrangler": "^4.123.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "types": "wrangler types .wrangler/worker-configuration.d.ts --env-interface CloudflareBindings",
    "typecheck": "npm run types && tsc --noEmit",
    "build": "npm run typecheck && wrangler deploy --dry-run --outdir .wrangler/build",
    "build:tiered": "npm run typecheck && wrangler deploy --dry-run --config wrangler.tiered.jsonc --outdir .wrangler/build-tiered",
    "dev": "npm run types && wrangler dev --local",
    "test": "npm run build && node --test tests/*.test.mjs"
  }
}
